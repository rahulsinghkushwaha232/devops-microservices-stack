# Root Compose configuration. Copy to .env before starting the stack.
MONGO_ROOT_USERNAME=devops
MONGO_ROOT_PASSWORD=change-me
MONGO_PORT=27017
APP_PORT=3000
USER_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002

# Internal service URLs used by the gateway and order-service.
USER_SERVICE_URL=http://user-service:3001
ORDER_SERVICE_URL=http://order-service:3002
USER_SERVICE_TIMEOUT_MS=5000
